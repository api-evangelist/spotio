      "info": {
        "name": "Connectors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all available connector for dataObject Type ID)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.spotio2.com/api/Connectors",
            "params": [
              {
                "name": "pageSize",
                "value": "",
