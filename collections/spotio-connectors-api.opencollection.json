            "name": "Get available variables for dataObjectType ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.spotio2.com/api/Connectors/variables",
            "params": [
              {
                "name": "dataObjectTypeId",
                "value": "",
