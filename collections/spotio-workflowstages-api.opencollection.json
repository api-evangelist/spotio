              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Moves a workflow stage to another group within a specified data object type."
        }
      ]
    }
  ],
  "bundled": true
