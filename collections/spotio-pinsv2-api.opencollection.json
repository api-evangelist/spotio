{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spotio 2.0 Pins V2 API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "PinsV2",
        "type": "folder"
      },
      "items": [
